# Set these as environment variables in your hosting provider or shell.
# Generate a unique admin token, for example with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=
HOST=127.0.0.1
PORT=8000

# Safaricom Daraja credentials. Use sandbox credentials for testing.
M_PESA_ENV=sandbox
M_PESA_CONSUMER_KEY=
M_PESA_CONSUMER_SECRET=
M_PESA_SHORTCODE=
M_PESA_PASSKEY=
# Must be a publicly reachable HTTPS endpoint ending in /api/mpesa/callback.
M_PESA_CALLBACK_URL=
# Use CustomerBuyGoodsOnline when your shortcode is a Till number.
M_PESA_TRANSACTION_TYPE=CustomerPayBillOnline
